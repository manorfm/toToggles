{
  "schema_version": 2,
  "catalog": {
    "application": {
      "id": "contract-app",
      "name": "SDK evaluation contract",
      "revision": "sdk-evaluation-v1",
      "toggles": [
        {
          "id": "payments",
          "path": "payments",
          "value": "payments",
          "enabled": true,
          "level": 0,
          "parent_id": null,
          "app_id": "contract-app",
          "has_activation_rule": false,
          "activation_rule": null
        },
        {
          "id": "payments-card",
          "path": "payments.card",
          "value": "card",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "country",
            "value": "BR,US",
            "config": { "context_key": "country" }
          }
        },
        {
          "id": "payments-card-tokenization",
          "path": "payments.card.tokenization",
          "value": "tokenization",
          "enabled": true,
          "level": 2,
          "parent_id": "payments-card",
          "app_id": "contract-app",
          "has_activation_rule": false,
          "activation_rule": null
        },
        {
          "id": "payments-cards",
          "path": "payments.cards",
          "value": "cards",
          "enabled": false,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": false,
          "activation_rule": null
        },
        {
          "id": "payments-cards-apple-pay",
          "path": "payments.cards.apple-pay",
          "value": "apple-pay",
          "enabled": true,
          "level": 2,
          "parent_id": "payments-cards",
          "app_id": "contract-app",
          "has_activation_rule": false,
          "activation_rule": null
        },
        {
          "id": "payments-ip-allowlist",
          "path": "payments.ip-allowlist",
          "value": "ip-allowlist",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "ip",
            "value": "203.0.113.0/24,198.51.100.10",
            "config": { "context_key": "ip" }
          }
        },
        {
          "id": "payments-ipv6-allowlist",
          "path": "payments.ipv6-allowlist",
          "value": "ipv6-allowlist",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "ip",
            "value": "2001:db8:42::/64,2001:db8:ffff::7",
            "config": { "context_key": "ip" }
          }
        },
        {
          "id": "payments-invalid-user-context",
          "path": "payments.invalid-user-context",
          "value": "invalid-user-context",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "user_id",
            "value": "user-1",
            "config": { "context_key": "attributes.plan" }
          }
        },
        {
          "id": "payments-invalid-attribute-context",
          "path": "payments.invalid-attribute-context",
          "value": "invalid-attribute-context",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "attribute",
            "value": "premium",
            "config": { "context_key": "user_id" }
          }
        },
        {
          "id": "payments-invalid-time-context",
          "path": "payments.invalid-time-context",
          "value": "invalid-time-context",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "time",
            "value": "00:00-23:59",
            "config": { "context_key": "country" }
          }
        },
        {
          "id": "payments-percentage-rollout",
          "path": "payments.percentage-rollout",
          "value": "percentage-rollout",
          "enabled": true,
          "level": 1,
          "parent_id": "payments",
          "app_id": "contract-app",
          "has_activation_rule": true,
          "activation_rule": {
            "type": "percentage",
            "value": "50",
            "config": { "context_key": "rollout_key" }
          }
        }
      ]
    }
  },
  "cases": [
    {
      "name": "country rule matches only its exact toggle",
      "path": "payments.card",
      "context": { "country": "BR" },
      "expected": true
    },
    {
      "name": "country rule fails closed without context",
      "path": "payments.card",
      "context": {},
      "expected": false
    },
    {
      "name": "country rule rejects a non-allowlisted country",
      "path": "payments.card",
      "context": { "country": "FR" },
      "expected": false
    },
    {
      "name": "ancestor rule does not cascade to a child toggle",
      "path": "payments.card.tokenization",
      "context": {},
      "expected": true
    },
    {
      "name": "disabled ancestor blocks its whole hierarchy",
      "path": "payments.cards.apple-pay",
      "context": {},
      "expected": false
    },
    {
      "name": "ip rule matches an IPv4 CIDR range",
      "path": "payments.ip-allowlist",
      "context": { "ip": "203.0.113.42" },
      "expected": true
    },
    {
      "name": "ip rule rejects a non-allowlisted address",
      "path": "payments.ip-allowlist",
      "context": { "ip": "192.0.2.7" },
      "expected": false
    },
    {
      "name": "ip rule fails closed for a malformed address",
      "path": "payments.ip-allowlist",
      "context": { "ip": "api.internal.example" },
      "expected": false
    },
    {
      "name": "ip rule matches an IPv6 CIDR range",
      "path": "payments.ipv6-allowlist",
      "context": { "ip": "2001:db8:42::123" },
      "expected": true
    },
    {
      "name": "ip rule matches an exact IPv6 literal",
      "path": "payments.ipv6-allowlist",
      "context": { "ip": "2001:db8:ffff::7" },
      "expected": true
    },
    {
      "name": "ip rule rejects an IPv6 address outside its CIDR range",
      "path": "payments.ipv6-allowlist",
      "context": { "ip": "2001:db8:43::1" },
      "expected": false
    },
    {
      "name": "invalid user ID context pair fails closed before resolution",
      "path": "payments.invalid-user-context",
      "context": { "attributes.plan": "premium" },
      "expected": false,
      "resolver_calls": 0
    },
    {
      "name": "invalid attribute context pair fails closed before resolution",
      "path": "payments.invalid-attribute-context",
      "context": { "user_id": "user-1" },
      "expected": false,
      "resolver_calls": 0
    },
    {
      "name": "time rule with context pair fails closed before resolution",
      "path": "payments.invalid-time-context",
      "context": { "country": "BR" },
      "expected": false,
      "resolver_calls": 0
    },
    {
      "name": "percentage rule activates a key that falls inside its deterministic bucket",
      "path": "payments.percentage-rollout",
      "context": { "rollout_key": "user-42" },
      "expected": true
    },
    {
      "name": "percentage rule rejects a key that falls outside its deterministic bucket",
      "path": "payments.percentage-rollout",
      "context": { "rollout_key": "user-7" },
      "expected": false
    },
    {
      "name": "percentage rule fails closed without a rollout key",
      "path": "payments.percentage-rollout",
      "context": {},
      "expected": false
    }
  ]
}
