# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Output of the go coverage tool, build artifacts
*.coverprofile
*.cov
*.log

# Dependency directories (remove the comment below if you use Go modules)
vendor/

# Go workspace file
go.work
go.work.sum

# Go module files (uncomment if you want to ignore them, but usually you want to keep them)
# go.mod
# go.sum

# Node.js (server/web and any other JS/TS sub-project) — catches a stray node_modules/
# anywhere in the tree even without cd'ing into the right sub-project first.
node_modules/
npm-debug.log*
.npm/
coverage/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo
*.DS_Store

# Test binary, coverage, and result files
*.test
*.prof
*.tmp

# Generated docs
docs/swagger.json
docs/swagger.yaml

# Local environment files
.env
.env.*

# Database files
*.db
*.sqlite

# Plaintext initial-root-password file (server/internal/app/usecase/auth_usecase.go) — can appear
# anywhere DB_PATH's directory resolves to (a real deploy, local `make dev`, or a `go test` run
# that exercises full app init) — never allow it to slip into a commit.
initial-root-password.txt

# OS generated files
Thumbs.db
.DS_Store

# Migration logs or temp files
migrations/*.tmp
migrations/*.log

# Build output
bin/
dist/
test-key