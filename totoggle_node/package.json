{
  "name": "totoggle-node",
  "version": "1.0.0",
  "description": "Node.js/TypeScript client library for the ToToggle feature-flag server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Manoel Medeiros <manoel.rodrigo@gmail.com>",
  "homepage": "https://github.com/manorfm/toToggles/tree/main/totoggle_node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manorfm/toToggles.git",
    "directory": "totoggle_node"
  },
  "bugs": {
    "url": "https://github.com/manorfm/toToggles/issues"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "totoggle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
